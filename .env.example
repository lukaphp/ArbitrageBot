# ========================================
# CONFIGURAZIONE ARBITRAGE BOT - TESTNET
# ========================================
# ATTENZIONE: Questo file contiene solo esempi
# Copiare in .env e inserire i valori reali
# NON committare mai il file .env nel repository

# ========================================
# MODULO DEMO ARBITRAGGIO EVM
# ========================================
# Demo educativa (prezzi simulati, NON arbitraggio reale). Disattivata di default
# e da tenere OFF in produzione. Le variabili EVM qui sotto servono solo se =true.
DEMO_EVM_ENABLED=false

# ========================================
# CONFIGURAZIONE RETE (solo demo EVM)
# ========================================
# Modalità di esecuzione (SEMPRE testnet per sviluppo)
NETWORK_MODE=testnet

# RPC URLs per testnet (Infura, Alchemy, o provider pubblici)
ETHEREUM_TESTNET_RPC=https://goerli.infura.io/v3/YOUR_PROJECT_ID
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.binance.org:8545
POLYGON_TESTNET_RPC=https://rpc-mumbai.maticvigil.com

# ========================================
# WALLET CONFIGURATION
# ========================================
# IMPORTANTE: Non inserire mai la seed phrase qui
# Utilizzare MetaMask o hardware wallet per firmare transazioni
WALLET_ADDRESS=0x1234567890123456789012345678901234567890

# ========================================
# API KEYS (per raccolta dati prezzi)
# ========================================
# CoinGecko API (gratuita per uso limitato)
COINGECKO_API_KEY=your_coingecko_api_key_here

# 1inch API per aggregazione prezzi
ONEINCH_API_KEY=your_1inch_api_key_here

# Moralis API per dati blockchain
MORALIS_API_KEY=your_moralis_api_key_here

# ========================================
# PARAMETRI ARBITRAGGIO
# ========================================
# Profitto minimo per eseguire arbitraggio (in percentuale)
MIN_PROFIT_PERCENTAGE=0.5

# Importo massimo per transazione (in ETH/BNB/MATIC)
MAX_TRANSACTION_AMOUNT=0.1

# Gas price massimo accettabile (in Gwei)
MAX_GAS_PRICE=50

# Slippage tolerance (in percentuale)
SLIPPAGE_TOLERANCE=1.0

# ========================================
# CONFIGURAZIONE SICUREZZA
# ========================================
# Abilita controlli di sicurezza aggiuntivi
ENABLE_SECURITY_CHECKS=true

# Abilita simulazione prima dell'esecuzione
ENABLE_SIMULATION=true

# Limite giornaliero di transazioni
DAILY_TRANSACTION_LIMIT=10

# ========================================
# LOGGING E MONITORING
# ========================================
# Livello di log (debug, info, warn, error)
LOG_LEVEL=info

# Abilita salvataggio log su file
ENABLE_FILE_LOGGING=true

# Directory per i log
LOG_DIRECTORY=./logs

# ========================================
# CONFIGURAZIONE DEX
# ========================================
# DEX da monitorare (separati da virgola)
MONITORED_DEX=uniswap,sushiswap,pancakeswap

# Token da monitorare per arbitraggio
MONITORED_TOKENS=WETH,USDC,USDT,DAI

# Intervallo di aggiornamento prezzi (in millisecondi)
PRICE_UPDATE_INTERVAL=5000

# ========================================
# NOTIFICHE (opzionale)
# ========================================
# Webhook Discord per notifiche
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_URL

# Email per notifiche critiche
NOTIFICATION_EMAIL=your-email@example.com

# ========================================
# CONFIGURAZIONE AVANZATA
# ========================================
# Timeout per richieste HTTP (in millisecondi)
HTTP_TIMEOUT=10000

# Numero massimo di retry per transazioni fallite
MAX_RETRY_ATTEMPTS=3

# Intervallo tra retry (in millisecondi)
RETRY_INTERVAL=2000
# ============================================================
# PRODUZIONE & SICUREZZA (Perps Hyperliquid)
# ============================================================
# Ambiente: 'production' attiva i controlli di sicurezza obbligatori.
NODE_ENV=production

# --- Autenticazione single-user ---
# Hash della password del pannello. Genera con:
#   node scripts/hash-password.js 'la-tua-password-forte'
APP_PASSWORD_HASH=scrypt$REPLACE_ME
# Segreto per firmare i token di sessione (stringa casuale lunga, >=32 char).
#   openssl rand -hex 32
SESSION_SECRET=REPLACE_WITH_RANDOM_HEX
# Origine consentita per CORS/cookie (il dominio pubblico dell'app).
APP_ORIGIN=https://trading.tuodominio.it

# --- Chiave di cifratura dei segreti a riposo (chiavi agent, token Telegram) ---
# OBBLIGATORIA in produzione (>=32 caratteri).
#   openssl rand -hex 32
AGENT_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_HEX_32B

# Id della chiave corrente. Ogni segreto cifrato viene marcato con questo numero
# ("v<id>:..."), il che rende la chiave RUOTABILE: le vecchie restano disponibili
# per la sola decifratura finché i dati non sono stati ri-cifrati.
AGENT_ENCRYPTION_KEY_ID=1

# Chiavi precedenti, SOLO per decifrare, nel formato "id:segreto" separate da ';'.
# Vuoto quando non c'è una rotazione in corso.
#   Esempio: AGENT_ENCRYPTION_KEYS_OLD=1:vecchioSegreto;2:ancoraPiuVecchio
AGENT_ENCRYPTION_KEYS_OLD=

# COME RUOTARE LA CHIAVE
#   1. ./scripts/backup.sh
#   2. sposta il segreto attuale in AGENT_ENCRYPTION_KEYS_OLD come "<id>:<segreto>"
#      metti il nuovo in AGENT_ENCRYPTION_KEY e incrementa AGENT_ENCRYPTION_KEY_ID
#   3. node scripts/rotate-encryption-key.js            (verifica, non scrive)
#   4. node scripts/rotate-encryption-key.js --apply    (ri-cifra)
#   5. riavvia; dopo qualche giorno svuota AGENT_ENCRYPTION_KEYS_OLD

# --- Rete Hyperliquid ---
# 'testnet' (default) o 'mainnet'. Il mainnet (denaro reale) richiede ALLOW_MAINNET=true.
HYPERLIQUID_NETWORK=testnet
# Conferma esplicita per operare su mainnet con denaro reale.
ALLOW_MAINNET=false

# --- Limiti di rischio prudenti (mainnet) ---
PERPS_MAX_LEVERAGE=10
PERPS_MAX_POSITION_USD=500
PERPS_DEFAULT_LEVERAGE=3
PERPS_MAX_DAILY_LOSS_USD=100

# --- Rete del server ---
# Porta interna e host di bind. Dietro reverse proxy lascia 127.0.0.1.
PORT=3000
BIND_HOST=127.0.0.1

# NOTA: NETWORK_MODE (sopra) riguarda l'arbitraggio EVM e resta 'testnet';
# la rete Hyperliquid è governata separatamente da HYPERLIQUID_NETWORK.

# ============================================================
# SISTEMA AGENTICO + ANALYST AI (Claude) — solo advisory
# ============================================================
# Abilita gli agenti e l'Analyst AI.
AGENTS_ENABLED=false
# Chiave API Anthropic (per l'Analyst). https://console.anthropic.com
ANTHROPIC_API_KEY=
# Modello per l'analisi (claude-haiku-4-5 economico, claude-sonnet-4-6, claude-opus-4-8).
AGENT_ANALYST_MODEL=claude-sonnet-4-6
# Cadenza dell'Analyst (minuti) e cap chiamate/ora (costi/latenza).
AGENT_CADENCE_MIN=30
AGENT_MAX_CALLS_PER_HOUR=8
# Scadenza delle proposte non approvate (minuti).
AGENT_PROPOSAL_TTL_MIN=30
# Whitelist mercati per aperture suggerite (vuota = tutti). Es: ETH,BTC,SOL
AGENT_MARKET_WHITELIST=

# --- Prezzi STIMATI Claude (USD per 1M token) per il calcolo del costo Analyst ---
# Aggiorna se i listini cambiano. Default: opus 15/75, sonnet 3/15, haiku 1/5.
PRICE_OPUS_IN=15
PRICE_OPUS_OUT=75
PRICE_SONNET_IN=3
PRICE_SONNET_OUT=15
PRICE_HAIKU_IN=1
PRICE_HAIKU_OUT=5
