    "node_paste_ffaf4526bae9": {
      "type": "variant",
      "id": "node_paste_ffaf4526bae9",
      "label": "dash-trading-cockpit",
      "html": "<style>html, body { margin: 0; padding: 0; } #root { display: contents; }</style>\n\n  <div id=\"root\" data-kid=\"0\"><style data-kid=\"1\">\n@import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Inter:wght@400;500;600&display=swap');\n:root{\n  --navy:#0A0F1C;--bid:#26D07C;--ask:#FF4D4D;--fog:#8B97A8;--gold:#F5C451;\n  --p1:#0E1424;--p2:#111A2E;--line:#1B2538;\n}\n.mono{font-family:'JetBrains Mono',monospace;}\n.inter{font-family:'Inter',sans-serif;}\n.t10{font-size:10px;line-height:13px;}\n.t12{font-size:12px;line-height:15px;}\n.t16{font-size:16px;line-height:19px;}\n.row-focus:focus{outline:1px solid var(--gold);outline-offset:-1px;}\n.flash-up{animation:fu .3s ease-out;}\n.flash-dn{animation:fd .3s ease-out;}\n@keyframes fu{0%{background:rgba(38,208,124,.45);}100%{background:transparent;}}\n@keyframes fd{0%{background:rgba(255,77,77,.45);}100%{background:transparent;}}\n::-webkit-scrollbar{width:6px;height:6px;}\n::-webkit-scrollbar-thumb{background:var(--line);}\n::-webkit-scrollbar-track{background:transparent;}\n.tab-active{color:var(--navy);background:var(--gold);}\n</style>\n\n<div class=\"fixed inset-0\" style=\"background:var(--navy);overflow:auto;\" data-kid=\"2\">\n<div class=\"mono flex flex-col min-w-[1024px] w-full h-full\" style=\"background:var(--navy);color:var(--fog);overflow:hidden;\" data-kid=\"3\">\n\n  \n  <div class=\"flex items-stretch justify-between t10\" style=\"background:var(--p2);border-bottom:1px solid var(--line);\" data-kid=\"4\">\n    <div class=\"flex items-stretch\" data-kid=\"5\">\n      <div class=\"flex items-center gap-2 px-3 py-2\" style=\"border-right:1px solid var(--line);\" data-kid=\"6\">\n        <span style=\"color:var(--gold);\" class=\"t12 font-bold tracking-widest\" data-kid=\"7\">▣ COCKPIT</span>\n        <span class=\"t10\" data-kid=\"8\">v2.1</span>\n      </div>\n      <div class=\"flex items-center gap-3 px-3\" style=\"border-right:1px solid var(--line);\" data-kid=\"9\">\n        <span data-kid=\"10\">SESSION</span><span style=\"color:var(--bid);\" class=\"font-bold\" data-kid=\"11\">RTH · LIVE</span>\n      </div>\n      <div class=\"flex items-center gap-2 px-3\" style=\"border-right:1px solid var(--line);\" data-kid=\"12\">\n        <span data-kid=\"13\">LATENCY</span>\n        <span class=\"flex gap-px items-end h-3\" data-kid=\"14\">\n          <i class=\"block w-1\" style=\"height:40%;background:var(--bid);\" data-kid=\"15\"></i>\n          <i class=\"block w-1\" style=\"height:60%;background:var(--bid);\" data-kid=\"16\"></i>\n          <i class=\"block w-1\" style=\"height:80%;background:var(--bid);\" data-kid=\"17\"></i>\n          <i class=\"block w-1\" style=\"height:100%;background:var(--gold);\" data-kid=\"18\"></i>\n          <i class=\"block w-1\" style=\"height:55%;background:var(--line);\" data-kid=\"19\"></i>\n        </span>\n        <span style=\"color:var(--bid);\" data-kid=\"20\">4ms</span>\n      </div>\n      <div class=\"flex items-center gap-3 px-3\" style=\"border-right:1px solid var(--line);\" data-kid=\"21\">\n        <span data-kid=\"22\">FEED</span><span style=\"color:var(--bid);\" data-kid=\"23\">●</span>\n        <span data-kid=\"24\">CME · ICE · COMEX</span>\n      </div>\n    </div>\n    <div class=\"flex items-stretch\" data-kid=\"25\">\n      <div class=\"flex items-center gap-3 px-3\" style=\"border-left:1px solid var(--line);\" data-kid=\"26\">\n        <span data-kid=\"27\">EQUITY</span>\n        <span class=\"px-2 py-px font-bold\" style=\"background:var(--gold);color:var(--navy);\" data-kid=\"28\">⚑ $248,412.50</span>\n      </div>\n      <div class=\"flex items-center gap-3 px-3\" style=\"border-left:1px solid var(--line);\" data-kid=\"29\">\n        <span data-kid=\"30\">BP</span><span style=\"color:#fff;\" data-kid=\"31\">$1.24M</span>\n      </div>\n      <div class=\"flex items-center gap-2 px-3\" style=\"border-left:1px solid var(--line);\" data-kid=\"32\">\n        <span id=\"clock\" style=\"color:#fff;\" data-kid=\"33\">14:32:07</span><span data-kid=\"34\">EST</span>\n      </div>\n    </div>\n  </div>\n\n  \n  <div class=\"flex-1 grid min-h-0\" style=\"grid-template-columns:300px 1fr;gap:1px;background:#000;\" data-kid=\"35\">\n\n    \n    <div class=\"flex flex-col min-h-0\" style=\"background:var(--p1);\" data-kid=\"36\">\n      <div class=\"flex items-center justify-between px-3 py-2 t10\" style=\"border-bottom:1px solid var(--line);\" data-kid=\"37\">\n        <span class=\"font-bold tracking-widest\" style=\"color:#fff;\" data-kid=\"38\">ORDER BOOK · NQ</span>\n        <span style=\"color:var(--gold);\" data-kid=\"39\">DOM</span>\n      </div>\n      <div class=\"grid t10 px-3 py-1\" style=\"grid-template-columns:1fr 1fr 1fr;border-bottom:1px solid var(--line);\" data-kid=\"40\">\n        <span data-kid=\"41\">SIZE</span><span class=\"text-center\" data-kid=\"42\">PRICE</span><span class=\"text-right\" data-kid=\"43\">DEPTH</span>\n      </div>\n      <div id=\"ladder\" class=\"flex-1 overflow-hidden flex flex-col\" data-kid=\"44\"></div>\n    </div>\n\n    \n    <div class=\"grid min-h-0\" style=\"grid-template-rows:1.45fr 1fr;gap:1px;background:#000;\" data-kid=\"45\">\n\n      \n      <div class=\"flex flex-col min-h-0\" style=\"background:var(--p1);\" data-kid=\"46\">\n        <div class=\"flex items-center justify-between px-3 py-2\" style=\"border-bottom:1px solid var(--line);\" data-kid=\"47\">\n          <div class=\"flex items-center gap-3 t12\" data-kid=\"48\">\n            <span class=\"font-bold t16\" style=\"color:#fff;\" data-kid=\"49\">NQ</span>\n            <span id=\"chartPx\" class=\"t16 font-bold\" style=\"color:var(--bid);\" data-kid=\"50\">20,142.25</span>\n            <span style=\"color:var(--bid);\" class=\"t10\" data-kid=\"51\">+86.50 (+0.43%)</span>\n          </div>\n          <div class=\"flex t10\" style=\"border:1px solid var(--line);\" data-kid=\"52\">\n            <span class=\"px-2 py-1 cursor-pointer\" data-kid=\"53\">1m</span>\n            <span class=\"px-2 py-1 cursor-pointer tab-active font-bold\" data-kid=\"54\">5m</span>\n            <span class=\"px-2 py-1 cursor-pointer\" style=\"border-left:1px solid var(--line);\" data-kid=\"55\">15m</span>\n            <span class=\"px-2 py-1 cursor-pointer\" style=\"border-left:1px solid var(--line);\" data-kid=\"56\">1H</span>\n          </div>\n        </div>\n        <div class=\"flex-1 min-h-0 relative\" data-kid=\"57\">\n          <canvas id=\"chart\" class=\"absolute inset-0 w-full h-full\" data-kid=\"58\"></canvas>\n        </div>\n      </div>\n\n      \n      <div class=\"grid min-h-0\" style=\"grid-template-columns:1.3fr 1fr;gap:1px;background:#000;\" data-kid=\"59\">\n\n        \n        <div class=\"flex flex-col min-h-0\" style=\"background:var(--p1);\" data-kid=\"60\">\n          <div class=\"flex items-center justify-between px-3 py-2 t10\" style=\"border-bottom:1px solid var(--line);\" data-kid=\"61\">\n            <span class=\"font-bold tracking-widest\" style=\"color:#fff;\" data-kid=\"62\">POSITIONS</span>\n            <span data-kid=\"63\">4 OPEN</span>\n          </div>\n          <div class=\"grid t10 px-3 py-1\" style=\"grid-template-columns:46px 38px 40px 1fr 1fr 1fr 48px;border-bottom:1px solid var(--line);gap:4px;\" data-kid=\"64\">\n            <span data-kid=\"65\">SYM</span><span data-kid=\"66\">SIDE</span><span class=\"text-right\" data-kid=\"67\">QTY</span><span class=\"text-right\" data-kid=\"68\">AVG</span><span class=\"text-right\" data-kid=\"69\">LAST</span><span class=\"text-right\" data-kid=\"70\">uPnL</span><span class=\"text-right\" data-kid=\"71\">%CHG</span>\n          </div>\n          <div id=\"blotter\" class=\"flex-1 overflow-auto t12\" data-kid=\"72\"></div>\n        </div>\n\n        \n        <div class=\"flex flex-col min-h-0\" style=\"background:var(--p1);\" data-kid=\"73\">\n          <div class=\"flex items-center justify-between px-3 py-2 t10\" style=\"border-bottom:1px solid var(--line);\" data-kid=\"74\">\n            <span class=\"font-bold tracking-widest\" style=\"color:#fff;\" data-kid=\"75\">P&L TAPE</span>\n            <span data-kid=\"76\">RTH</span>\n          </div>\n          <div class=\"px-3 py-2 flex items-end justify-between\" style=\"border-bottom:1px solid var(--line);\" data-kid=\"77\">\n            <div data-kid=\"78\">\n              <div class=\"t10\" data-kid=\"79\">NET P&L</div>\n              <div id=\"netpnl\" class=\"t16 font-bold\" style=\"color:var(--bid);\" data-kid=\"80\">+$4,287.50</div>\n            </div>\n            <div class=\"text-right\" data-kid=\"81\">\n              <div class=\"t10\" data-kid=\"82\">REALIZED</div>\n              <div class=\"t12\" style=\"color:var(--bid);\" data-kid=\"83\">+$1,920</div>\n            </div>\n          </div>\n          <div class=\"px-3 py-1\" style=\"border-bottom:1px solid var(--line);\" data-kid=\"84\">\n            <canvas id=\"spark\" class=\"w-full\" style=\"height:38px;\" data-kid=\"85\"></canvas>\n          </div>\n          <div class=\"t10 px-3 py-1\" style=\"color:var(--fog);\" data-kid=\"86\">FILLS</div>\n          <div id=\"fills\" class=\"flex-1 overflow-auto t10 px-3\" data-kid=\"87\"></div>\n        </div>\n\n      </div>\n    </div>\n  </div>\n\n  \n  <div class=\"flex items-center justify-between px-3 py-2 t12\" style=\"background:var(--p2);border-top:1px solid var(--line);\" data-kid=\"88\">\n    <div class=\"flex items-center gap-2\" data-kid=\"89\">\n      <span style=\"color:var(--gold);\" class=\"font-bold\" data-kid=\"90\">&gt;</span>\n      <span style=\"color:var(--ask);\" class=\"font-bold\" data-kid=\"91\">SELL</span>\n      <span style=\"color:#fff;\" data-kid=\"92\">2 NQ @ LMT 20142.25</span>\n      <span class=\"inline-block w-2 h-3\" style=\"background:var(--gold);animation:fu 1s infinite;\" data-kid=\"93\"></span>\n    </div>\n    <div class=\"flex items-center gap-4 t10\" data-kid=\"94\">\n      <span data-kid=\"95\"><span style=\"color:var(--gold);\" data-kid=\"96\">F1</span> <span style=\"color:var(--bid);\" data-kid=\"97\">BUY</span></span>\n      <span data-kid=\"98\"><span style=\"color:var(--gold);\" data-kid=\"99\">F2</span> <span style=\"color:var(--ask);\" data-kid=\"100\">SELL</span></span>\n      <span data-kid=\"101\"><span style=\"color:var(--gold);\" data-kid=\"102\">F3</span> FLATTEN</span>\n      <span data-kid=\"103\"><span style=\"color:var(--gold);\" data-kid=\"104\">ESC</span> CANCEL</span>\n    </div>\n  </div>\n</div>\n</div>\n\n<script type=\"module\" data-kid=\"105\">\nimport { animate } from 'https://esm.sh/animejs@4';\n\n// ---------- ORDER BOOK ----------\nconst ladder = document.getElementById('ladder');\nlet mid = 20142.25;\nconst ROWH = 0;\nfunction buildLadder(){\n  ladder.innerHTML='';\n  // 9 asks (top, red), spread, 9 bids\n  const asks=[],bids=[];\n  for(let i=9;i>=1;i--) asks.push(mid + i*0.25);\n  for(let i=1;i<=9;i++) bids.push(mid - i*0.25);\n  asks.forEach((p,idx)=>ladder.appendChild(rowEl(p,'ask',idx)));\n  ladder.appendChild(spreadEl());\n  bids.forEach((p,idx)=>ladder.appendChild(rowEl(p,'bid',idx)));\n}\nfunction rowEl(price,side,idx){\n  const sz=Math.floor(Math.random()*180)+20;\n  const depth=Math.floor(Math.random()*60)+25;\n  const col=side==='ask'?'var(--ask)':'var(--bid)';\n  const d=document.createElement('div');\n  d.className='ladder-row grid items-center px-3 t12 row-focus cursor-pointer';\n  d.tabIndex=0;\n  d.style.cssText='grid-template-columns:1fr 1fr 1fr;height:24px;border-bottom:1px solid #11182b;position:relative;';\n  d.innerHTML=`\n    <div class=\"depth-bg\" style=\"position:absolute;${side==='ask'?'right:0':'left:0'};top:0;bottom:0;width:${depth}%;background:${side==='ask'?'rgba(255,77,77,.10)':'rgba(38,208,124,.10)'};\"></div>\n    <span class=\"sz\" style=\"position:relative;color:#cdd6e4;\">${sz}</span>\n    <span class=\"text-center font-bold\" style=\"position:relative;color:${col};\">${price.toFixed(2)}</span>\n    <span class=\"depthnum text-right t10\" style=\"position:relative;color:var(--fog);\">${depth}%</span>`;\n  return d;\n}\nfunction spreadEl(){\n  const d=document.createElement('div');\n  d.className='grid items-center px-3 t12';\n  d.style.cssText='grid-template-columns:1fr 1fr 1fr;height:24px;background:rgba(245,196,81,.14);border-top:1px solid var(--gold);border-bottom:1px solid var(--gold);';\n  d.innerHTML=`<span class=\"t10\" style=\"color:var(--gold);\">SPREAD</span>\n    <span class=\"text-center font-bold\" style=\"color:var(--gold);\">${mid.toFixed(2)}</span>\n    <span class=\"text-right t10\" style=\"color:var(--gold);\">0.25</span>`;\n  return d;\n}\nbuildLadder();\n\n// mechanical shift + flash\nfunction ladderTick(){\n  const dir = Math.random()>0.5?1:-1;\n  // flash random cells\n  const rows=[...ladder.querySelectorAll('.ladder-row')];\n  rows.forEach(r=>{\n    if(Math.random()>0.7){\n      r.classList.remove('flash-up','flash-dn');\n      void r.offsetWidth;\n      r.classList.add(dir>0?'flash-up':'flash-dn');\n      const sz=r.querySelector('.sz'); sz.textContent=Math.floor(Math.random()*180)+20;\n      const dn=r.querySelector('.depthnum'); const nd=Math.floor(Math.random()*60)+25;\n      dn.textContent=nd+'%'; r.querySelector('.depth-bg').style.width=nd+'%';\n    }\n  });\n  // snap shift the whole ladder by one row height\n  animate(ladder,{translateY:[dir*24*0.4,0],duration:90,ease:'outQuad'});\n}\nsetInterval(ladderTick,1300);\n\n// ---------- BLOTTER ----------\nconst positions=[\n  {sym:'ES',side:'LONG',qty:3,avg:5842.25,last:5851.50,focus:false},\n  {sym:'NQ',side:'SHORT',qty:2,avg:20155.00,last:20142.25,focus:true},\n  {sym:'CL',side:'LONG',qty:5,avg:71.82,last:72.41,focus:false},\n  {sym:'GC',side:'SHORT',qty:1,avg:2658.40,last:2651.90,focus:false},\n];\nconst blotter=document.getElementById('blotter');\nfunction renderBlotter(){\n  blotter.innerHTML='';\n  positions.forEach((p,i)=>{\n    const long=p.side==='LONG';\n    const pnl=(p.last-p.avg)*(long?1:-1)*p.qty*(p.sym==='CL'?1000:(p.sym==='GC'?100:50));\n    const pct=((p.last-p.avg)/p.avg*100)*(long?1:-1);\n    const pc=pnl>=0?'var(--bid)':'var(--ask)';\n    const d=document.createElement('div');\n    d.className='blot-row grid items-center px-3 row-focus';\n    d.tabIndex=0;\n    d.style.cssText=`grid-template-columns:46px 38px 40px 1fr 1fr 1fr 48px;gap:4px;height:30px;border-bottom:1px solid #11182b;${p.focus?'outline:1px solid var(--gold);outline-offset:-1px;':''}`;\n    d.innerHTML=`<span class=\"font-bold\" style=\"color:#fff;\">${p.sym}</span>\n      <span class=\"t10\" style=\"color:${long?'var(--bid)':'var(--ask)'};\">${p.side}</span>\n      <span class=\"text-right\">${p.qty}</span>\n      <span class=\"text-right t10\" style=\"color:#cdd6e4;\">${p.avg.toFixed(2)}</span>\n      <span class=\"last text-right\" data-i=\"${i}\" style=\"color:#fff;\">${p.last.toFixed(2)}</span>\n      <span class=\"text-right t10 font-bold\" style=\"color:${pc};\">${pnl>=0?'+':''}${pnl.toFixed(0)}</span>\n      <span class=\"text-right t10\" style=\"color:${pc};\">${pct>=0?'+':''}${pct.toFixed(2)}%</span>`;\n    blotter.appendChild(d);\n  });\n}\nrenderBlotter();\nfunction blotTick(){\n  const i=Math.floor(Math.random()*positions.length);\n  const p=positions[i];\n  const dir=Math.random()>0.5?1:-1;\n  const step=p.sym==='CL'?0.03:(p.sym==='GC'?0.5:0.25);\n  p.last=+(p.last+dir*step).toFixed(2);\n  renderBlotter();\n  const cell=blotter.querySelector(`.last[data-i=\"${i}\"]`);\n  if(cell){cell.classList.add(dir>0?'flash-up':'flash-dn');}\n}\nsetInterval(blotTick,1100);\n\n// ---------- P&L ----------\nlet net=4287.50;\nconst netEl=document.getElementById('netpnl');\nfunction netTick(){\n  const dir=Math.random()>0.45?1:-1;\n  net=+(net+dir*(Math.random()*120)).toFixed(2);\n  netEl.textContent=(net>=0?'+$':'-$')+Math.abs(net).toLocaleString('en-US',{minimumFractionDigits:2});\n  netEl.style.color=net>=0?'var(--bid)':'var(--ask)';\n  netEl.classList.remove('flash-up','flash-dn');void netEl.offsetWidth;\n  netEl.classList.add(dir>0?'flash-up':'flash-dn');\n}\nsetInterval(netTick,1400);\n\n// FILLS\nconst fills=document.getElementById('fills');\nconst syms=['ES','NQ','CL','GC'];\nfunction addFill(){\n  const t=new Date();\n  const ts=t.toTimeString().slice(0,8);\n  const buy=Math.random()>0.5;\n  const sym=syms[Math.floor(Math.random()*4)];\n  const px=({ES:5851.5,NQ:20142.25,CL:72.41,GC:2651.9})[sym]+(Math.random()*4-2);\n  const d=document.createElement('div');\n  d.className='flex justify-between py-px';\n  d.innerHTML=`<span style=\"color:var(--fog);\">${ts}</span>\n    <span style=\"color:${buy?'var(--bid)':'var(--ask)'};\">${buy?'BUY':'SELL'} ${Math.ceil(Math.random()*4)} ${sym}</span>\n    <span style=\"color:#cdd6e4;\">${px.toFixed(2)}</span>`;\n  fills.prepend(d);\n  if(fills.children.length>40) fills.lastChild.remove();\n}\nfor(let i=0;i<12;i++) addFill();\nsetInterval(addFill,1700);\n\n// ---------- CANVAS HELPERS ----------\nfunction fit(c){const r=c.getBoundingClientRect();const dpr=devicePixelRatio||1;c.width=r.width*dpr;c.height=r.height*dpr;const x=c.getContext('2d');x.setTransform(dpr,0,0,dpr,0,0);return [x,r.width,r.height];}\n\n// CHART\nfunction genCandles(n){let p=20050;const a=[];for(let i=0;i<n;i++){const o=p;const ch=(Math.random()-0.48)*30;const c=o+ch;const hi=Math.max(o,c)+Math.random()*12;const lo=Math.min(o,c)-Math.random()*12;a.push({o,c,hi,lo,v:Math.random()});p=c;}return a;}\nconst candles=genCandles(70);\nfunction drawChart(){\n  const c=document.getElementById('chart');const [x,W,H]=fit(c);\n  x.clearRect(0,0,W,H);\n  const axisW=60, volH=H*0.18, chartH=H-volH-4;\n  let mn=Infinity,mx=-Infinity;candles.forEach(k=>{mn=Math.min(mn,k.lo);mx=Math.max(mx,k.hi);});\n  const pad=(mx-mn)*0.05;mn-=pad;mx+=pad;\n  const plotW=W-axisW;\n  const cw=plotW/candles.length;\n  const yp=v=>chartH-((v-mn)/(mx-mn))*chartH;\n  // grid\n  x.strokeStyle='#141d30';x.lineWidth=1;x.font='10px JetBrains Mono';x.fillStyle='#8B97A8';\n  for(let g=0;g<=5;g++){const yy=chartH/5*g;x.beginPath();x.moveTo(0,yy);x.lineTo(plotW,yy);x.stroke();\n    const val=mx-(mx-mn)/5*g;x.fillText(val.toFixed(0),plotW+6,yy+10);}\n  // candles\n  candles.forEach((k,i)=>{\n    const cx=i*cw+cw/2;const up=k.c>=k.o;const col=up?'#26D07C':'#FF4D4D';\n    x.strokeStyle=col;x.fillStyle=col;\n    x.beginPath();x.moveTo(cx,yp(k.hi));x.lineTo(cx,yp(k.lo));x.stroke();\n    const bw=Math.max(cw*0.6,1.5);\n    const top=yp(Math.max(k.o,k.c));const bot=yp(Math.min(k.o,k.c));\n    x.fillRect(cx-bw/2,top,bw,Math.max(bot-top,1));\n  });\n  // last price line\n  const lp=candles[candles.length-1].c;\n  x.strokeStyle='#F5C451';x.setLineDash([3,3]);x.beginPath();x.moveTo(0,yp(lp));x.lineTo(plotW,yp(lp));x.stroke();x.setLineDash([]);\n  x.fillStyle='#F5C451';x.fillRect(plotW,yp(lp)-7,axisW,14);x.fillStyle='#0A0F1C';x.fillText(lp.toFixed(2),plotW+4,yp(lp)+3);\n  // volume\n  candles.forEach((k,i)=>{const cx=i*cw;const up=k.c>=k.o;x.fillStyle=up?'rgba(38,208,124,.4)':'rgba(255,77,77,.4)';const vh=k.v*volH;x.fillRect(cx+1,chartH+4+(volH-vh),Math.max(cw-1.5,1),vh);});\n}\ndrawChart();\n\n// SPARK\nlet equity=[];let e=243000;for(let i=0;i<80;i++){e+=(Math.random()-0.42)*900;equity.push(e);}\nfunction drawSpark(prog){\n  const c=document.getElementById('spark');const [x,W,H]=fit(c);\n  x.clearRect(0,0,W,H);\n  let mn=Math.min(...equity),mx=Math.max(...equity);\n  const n=Math.floor(equity.length*prog);\n  x.strokeStyle='#26D07C';x.lineWidth=1.5;x.beginPath();\n  for(let i=0;i<n;i++){const px=i/(equity.length-1)*W;const py=H-((equity[i]-mn)/(mx-mn))*H;i?x.lineTo(px,py):x.moveTo(px,py);}\n  x.stroke();\n  if(n>1){const lx=(n-1)/(equity.length-1)*W;const ly=H-((equity[n-1]-mn)/(mx-mn))*H;\n    const grd=x.createLinearGradient(0,0,0,H);grd.addColorStop(0,'rgba(38,208,124,.25)');grd.addColorStop(1,'rgba(38,208,124,0)');\n    x.lineTo(lx,H);x.lineTo(0,H);x.closePath();x.fillStyle=grd;x.fill();}\n}\nanimate({p:0},{p:1,duration:1100,ease:'outCubic',onUpdate:s=>drawSpark(s.targets?s.targets[0].p:1)});\n// fallback simple animation\nlet sp=0;const si=setInterval(()=>{sp+=0.06;if(sp>=1){sp=1;clearInterval(si);}drawSpark(sp);},20);\n\n// chart drift\nsetInterval(()=>{const last=candles[candles.length-1];const ch=(Math.random()-0.48)*22;const o=last.c;const cc=o+ch;candles.push({o,c:cc,hi:Math.max(o,cc)+Math.random()*10,lo:Math.min(o,cc)-Math.random()*10,v:Math.random()});candles.shift();drawChart();\n  const cp=document.getElementById('chartPx');cp.textContent=cc.toLocaleString('en-US',{minimumFractionDigits:2});cp.style.color=cc>=o?'var(--bid)':'var(--ask)';},2000);\n\nwindow.addEventListener('resize',()=>{drawChart();drawSpark(1);});\n\n// clock\nsetInterval(()=>{document.getElementById('clock').textContent=new Date().toTimeString().slice(0,8);},1000);\n</script></div>\n  \n  \n",
