ext-[12px] font-medium\" data-kid=\"1-3-2-2-3-1\" data-name=\"realized p&l label\">\n                        Realized Session P&L:\n                    </span>\n                    <span class=\"text-white text-[13px] font-bold mono\" data-dynamic=\"true\" data-kid=\"1-3-2-2-3-2\" data-name=\"realized p&l value\" data-reason=\"value updated by real-time P&L feed script\">\n                        +$1,920.00\n                    </span>\n                </div>\n            </div>\n            <!-- MARGIN -->\n            <div class=\"bg-[var(--panel)] border border-[var(--border)] p-6 hover:border-[var(--gold)]/50 transition-all\" data-kid=\"1-3-2-3\" data-name=\"margin utilization card\">\n                <div class=\"text-[var(--text-muted)] text-[12px] font-bold uppercase tracking-[0.1em] mb-4\" data-kid=\"1-3-2-3-1\" data-name=\"margin utilization label\">\n                    Margin Utilization\n                </div>\n                <div class=\"flex items-center justify-between mb-3\" data-kid=\"1-3-2-3-2\" data-name=\"utilization statistics group\">\n                    <span class=\"text-white text-4xl font-bold mono tracking-tighter\" data-dynamic=\"true\" data-kid=\"1-3-2-3-2-1\" data-name=\"utilization percentage value\" data-reason=\"percentage updated by real-time margin script\">\n                        32%\n                    </span>\n                    <span class=\"text-[var(--text-muted)] text-[12px] mono font-bold\" data-dynamic=\"true\" data-kid=\"1-3-2-3-2-2\" data-name=\"free margin text\" data-reason=\"text updated by real-time margin script\">\n                        68% FREE\n                    </span>\n                </div>\n                <div class=\"w-full bg-[var(--border)] h-2.5 rounded-full overflow-hidden\" data-kid=\"1-3-2-3-3\" data-name=\"margin progress bar container\">\n                    <div class=\"bg-[var(--gold)] h-full w-[32%] transition-all duration-1000\" data-dynamic=\"true\" data-kid=\"1-3-2-3-3-1\" data-name=\"margin progress bar fill\" data-reason=\"bar width updated by real-time margin script\">\n                    </div>\n                </div>\n                <div class=\"mt-4 text-[12px] text-[var(--text-muted)] flex justify-between opacity-70\" data-kid=\"1-3-2-3-4\" data-name=\"maintenance buffer display\">\n                    <span data-kid=\"1-3-2-3-4-1\" data-name=\"maintenance label\">\n                        Maintenance: $42,100\n                    </span>\n                    <span class=\"text-[var(--green)] font-bold\" data-dynamic=\"true\" data-kid=\"1-3-2-3-4-2\" data-name=\"buffer status text\" data-reason=\"text/color state updated by real-time risk script\">\n                        BUFFER HIGH\n                    </span>\n                </div>\n            </div>\n            <!-- DRAWDOWN -->\n            <div class=\"bg-[var(--panel)] border border-[var(--border)] p-6 hover:border-[var(--gold)]/50 transition-all\" data-kid=\"1-3-2-4\" data-name=\"max drawdown card\">\n                <div class=\"text-[var(--text-muted)] text-[12px] font-bold uppercase tracking-[0.1em] mb-4\" data-kid=\"1-3-2-4-1\" data-name=\"drawdown label\">\n                    Max Drawdown (MTD)\n                </div>\n                <div class=\"flex items-center gap-6\" data-kid=\"1-3-2-4-2\" data-name=\"drawdown value group\">\n                    <span class=\"text-white text-4xl font-bold mono tracking-tighter\" data-dynamic=\"true\" data-kid=\"1-3-2-4-2-1\" data-name=\"drawdown percentage value\" data-reason=\"value updated by real-time risk script\">\n                        -1.8%\n                    </span>\n                    <span class=\"px-2.5 py-1 rounded-sm bg-[var(--green)]/10 text-[var(--green)] text-[11px] font-black uppercase border border-[var(--green)]/30 tracking-widest\" data-dynamic=\"true\" data-kid=\"1-3-2-4-2-2\" data-name=\"drawdown safety badge\" data-reason=\"text/color updated by real-time risk script\">\n                        SAFE\n                    </span>\n                </div>\n                <div class=\"mt-4 text-[12px] text-[var(--text-muted)] opacity-60\" data-kid=\"1-3-2-4-3\" data-name=\"drawdown limit group\">\n                    Threshold Limit:\n                    <span class=\"text-white mono font-bold\" data-kid=\"1-3-2-4-3-1\" data-name=\"drawdown threshold value\">\n                        -5.0%\n                    </span>\n                </div>\n            </div>\n        </div>\n        <!-- MIDDLE ROW: PERFORMANCE & ATTENTION -->\n        <div class=\"grid grid-cols-3 gap-6\" data-kid=\"1-3-3\" data-name=\"performance and attention row\">\n            <!-- Portfolio Performance -->\n            <div class=\"col-span-2 bg-[var(--panel)] border border-[var(--border)] flex flex-col h-[500px]\" data-kid=\"1-3-3-1\" data-name=\"portfolio performance chart section\">\n                <div class=\"px-6 py-5 border-b border-[var(--border)] flex items-center justify-between bg-[var(--navy)]/30\" data-kid=\"1-3-3-1-1\" data-name=\"chart header\">\n                    <h2 class=\"text-white text-[14px] font-bold uppercase tracking-widest\" data-kid=\"1-3-3-1-1-1\" data-name=\"chart title\">\n                        Portfolio Performance Line\n                    </h2>\n                    <div class=\"flex gap-3\" data-kid=\"1-3-3-1-1-2\" data-name=\"chart time-range button group\">\n                        <button class=\"px-4 py-1.5 text-[11px] font-black bg-[var(--border)] text-white rounded-sm hover:bg-[var(--border)]/80 transition-all uppercase tracking-widest\" data-kid=\"1-3-3-1-1-2-1\" data-name=\"1 day button\">\n                            1 Day\n                        </button>\n                        <button class=\"px-4 py-1.5 text-[11px] font-black text-[var(--text-muted)] hover:text-white transition-all uppercase tracking-widest\" data-kid=\"1-3-3-1-1-2-2\" data-name=\"1 week button\">\n                            1 Week\n                        </button>\n                        <button class=\"px-4 py-1.5 text-[11px] font-black text-[var(--text-muted)] hover:text-white transition-all uppercase tracking-widest\" data-kid=\"1-3-3-1-1-2-3\" data-name=\"1 month button\">\n                            1 Month\n                        </button>\n                        <button class=\"px-4 py-1.5 text-[11px] font-black text-[var(--text-muted)] hover:text-white transition-all uppercase tracking-widest\" data-kid=\"1-3-3-1-1-2-4\" data-name=\"ytd button\">\n                            YTD\n                        </button>\n                    </div>\n                </div>\n                <div class=\"flex-1 p-10 relative flex flex-col\" data-kid=\"1-3-3-1-2\" data-name=\"chart container\">\n                    <!-- Simplified Equity Graph using SVG -->\n                    <div class=\"flex-1 w-full\" data-kid=\"1-3-3-1-2-1\" data-name=\"chart visual area\">\n                        <svg class=\"w-full h-full\" data-dynamic=\"true\" data-kid=\"1-3-3-1-2-1-1\" data-name=\"chart path and gradient data\" data-reason=\"path coordinates and values re-rendered by charting script\" preserveaspectratio=\"none\" viewbox=\"0 0 1000 320\">\n                            <defs>\n                                <lineargradient id=\"chartGradient\" x1=\"0\" x2=\"0\" y1=\"0\" y2=\"1\">\n                                    <stop offset=\"0%\" stop-color=\"var(--green)\" stop-opacity=\"0.15\">\n                                    </stop>\n                                    <stop offset=\"100%\" stop-color=\"var(--green)\" stop-opacity=\"0\">\n                                    </stop>\n                                </lineargradient>\n                            </defs>\n                            <!-- Grid Lines -->\n                            <g stroke=\"var(--border)\" stroke-dasharray=\"4 4\" stroke-width=\"1\">\n                                <line x1=\"0\" x2=\"1000\" y1=\"60\" y2=\"60\">\n                                </line>\n                                <line x1=\"0\" x2=\"1000\" y1=\"120\" y2=\"120\">\n                                </line>\n                                <line x1=\"0\" x2=\"1000\" y1=\"180\" y2=\"180\">\n                                </line>\n                                <line x1=\"0\" x2=\"1000\" y1=\"240\" y2=\"240\">\n                                </line>\n                            </g>\n                            <!-- Data Area -->\n                            <path d=\"M0,250 L50,240 L120,260 L200,220 L280,180 L350,200 L420,150 L500,120 L580,140 L650,110 L720,80 L800,95 L880,50 L950,65 L1000,40 V300 H0 Z\" fill=\"url(#chartGradient)\">\n                            </path>\n                            <!-- Line -->\n                            <path d=\"M0,250 L50,240 L120,260 L200,220 L280,180 L350,200 L420,150 L500,120 L580,140 L650,110 L720,80 L800,95 L880,50 L950,65 L1000,40\" fill=\"none\" stroke=\"var(--green)\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\">\n                            </path>\n                        </svg>\n                    </div>\n                    <!-- Legend -->\n                    <div class=\"mt-6 flex items-center justify-between text-[12px] mono font-medium\" data-kid=\"1-3-3-1-2-2\" data-name=\"chart legend\">\n                        <div class=\"flex items-center gap-6\" data-kid=\"1-3-3-1-2-2-1\" data-name=\"equity legend group\">\n                            <div class=\"flex items-center gap-2.5\" data-kid=\"1-3-3-1-2-2-1-1\" data-name=\"equity line indicator\">\n                                <span class=\"w-3 h-0.5 bg-[var(--green)]\" data-kid=\"1-3-3-1-2-2-1-1-1\" data-name=\"line color indicator\">\n                                </span>\n                                Total Equity Line\n                            </div>\n                            <span class=\"opacity-40 italic\" data-kid=\"1-3-3-1-2-2-1-2\" data-name=\"benchmark comparison text\">\n                                Benchmark: S&P 500 Index (+0.82%)\n                            </span>\n                        </div>\n                        <div class=\"flex gap-10 opacity-60\" data-kid=\"1-3-3-1-2-2-2\" data-name=\"x-axis time markers\">\n                            <span data-kid=\"1-3-3-1-2-2-2-1\" data-name=\"8am marker\">\n                                08:00\n                            </span>\n                            <span data-kid=\"1-3-3-1-2-2-2-2\" data-name=\"10am marker\">\n                                10:00\n                            </span>\n                            <span data-kid=\"1-3-3-1-2-2-2-3\" data-name=\"12pm marker\">\n                                12:00\n                            </span>\n                            <span data-kid=\"1-3-3-1-2-2-2-4\" data-name=\"2pm marker\">\n                                14:00\n                            </span>\n                            <span data-kid=\"1-3-3-1-2-2-2-5\" data-name=\"4pm marker\">\n                                16:00\n                            </span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <!-- Needs Attention -->\n            <div class=\"bg-[var(--panel)] border border-[var(--border)] flex flex-col h-[500px]\" data-kid=\"1-3-3-2\" data-name=\"needs attention section\">\n                <div class=\"px-6 py-5 border-b border-[var(--border)] flex items-center justify-between bg-[var(--navy)]/30\" data-kid=\"1-3-3-2-1\" data-name=\"alerts header\">\n                    <div class=\"flex items-center gap-4\" data-kid=\"1-3-3-2-1-1\" data-name=\"alerts title group\">\n                        <h2 class=\"text-white text-[14px] font-bold uppercase tracking-widest\" data-kid=\"1-3-3-2-1-1-1\" data-name=\"alerts title\">\n                            Needs Attention\n                        </h2>\n                        <span class=\"bg-[var(--red)] text-white text-xs px-2.5 py-0.5 rounded-sm font-bold mono\" data-dynamic=\"true\" data-kid=\"1-3-3-2-1-1-2\" data-name=\"alerts count\" data-reason=\"count updated by real-time alert feed script\">\n                            3\n                        </span>\n                    </div>\n                    <a class=\"text-[12px] text-[var(--gold)] hover:underline font-black uppercase tracking-widest\" data-kid=\"1-3-3-2-1-2\" data-name=\"view all alerts link\" href=\"#\">\n                        View All Alerts\n                    </a>\n                </div>\n                <div class=\"flex-1 p-4 space-y-4 overflow-hidden\" data-kid=\"1-3-3-2-2\" data-name=\"alerts list container\">\n                    <!-- Critical Alert -->\n                    <div class=\"p-4 bg-[var(--red)]/5 border-l-[3px] border-[var(--red)] relative group\" data-dynamic=\"true\" data-kid=\"1-3-3-2-2-1\" data-name=\"critical severity alert card\" data-reason=\"rendered dynamically from alert feed script\">\n                        <div class=\"flex justify-between items-start mb-1.5\" data-kid=\"1-3-3-2-2-1-1\" data-name=\"critical alert meta\">\n                            <span class=\"text-[var(--red)] text-xs font-bold uppercase tracking-[0.1em]\" data-kid=\"1-3-3-2-2-1-1-1\" data-name=\"critical label\">\n                                Critical Severity\n                            </span>\n                            <span class=\"text-[var(--text-muted)] text-xs mono\" data-kid=\"1-3-3-2-2-1-1-2\" data-name=\"critical alert time\">\n                                14:28:12\n                            </span>\n                        </div>\n                        <h4 class=\"text-white text-sm font-bold mb-1\" data-kid=\"1-3-3-2-2-1-2\" data-name=\"critical alert title\">\n                            NQ exposure above limit\n                        </h4>\n                        <p class=\"text-[var(--text-muted)] text-sm leading-relaxed mb-4\" data-kid=\"1-3-3-2-2-1-3\" data-name=\"critical alert description\">\n                            Net exposure exceeds risk parameters ($1.2M vs $1.0M limit).\n                        </p>\n                        <div class=\"flex items-center justify-between\" data-kid=\"1-3-3-2-2-1-4\" data-name=\"critical alert actions\">\n                            <span class=\"text-[var(--text-muted)] text-xs font-medium italic\" data-kid=\"1-3-3-2-2-1-4-1\" data-name=\"critical impact text\">\n                                Impact: Risk violation\n                            </span>\n                            <button class=\"px-4 py-1.5 bg-[var(--gold)] text-[var(--navy)] text-xs font-black uppercase rounded shadow-sm hover:scale-[1.02] active:scale-[0.98] transition-all\" data-kid=\"1-3-3-2-2-1-4-2\" data-name=\"critical review button\">\n                                Review\n                            </button>\n                        </div>\n                    </div>\n                    <!-- Warning Alert 1 -->\n                    <div class=\"p-4 bg-[var(--gold)]/5 border-l-[3px] border-[var(--gold)] relative group\" data-dynamic=\"true\" data-kid=\"1-3-3-2-2-2\" data-name=\"warning alert 1 card\" data-reason=\"rendered dynamically from alert feed script\">\n                        <div class=\"flex justify-between items-start mb-1.5\" data-kid=\"1-3-3-2-2-2-1\" data-name=\"warning meta\">\n                            <span class=\"text-[var(--gold)] text-[10px] font-bold uppercase tracking-[0.1em]\" data-kid=\"1-3-3-2-2-2-1-1\" data-name=\"warning label\">\n                                Operational Warning\n                            </span>\n                            <span class=\"text-[var(--text-muted)] text-[10px] mono\" data-kid=\"1-3-3-2-2-2-1-2\" data-name=\"warning time\">\n                                14:15:00\n                            </span>\n                        </div>\n                        <h4 class=\"text-white text-[13px] font-bold mb-1\" data-kid=\"1-3-3-2-2-2-2\" data-name=\"warning title\">\n                            Feed latency above threshold\n                        </h4>\n                        <p class=\"text-[var(--text-muted)] text-[11px] leading-relaxed mb-4\" data-kid=\"1-3-3-2-2-2-3\" data-name=\"warning description\">\n                            Market data jitter detected on CME Gateway #4 cluster.\n                        </p>\n                        <div class=\"flex items-center justify-between\" data-kid=\"1-3-3-2-2-2-4\" data-name=\"warning actions\">\n                            <span class=\"text-[var(--text-muted)] text-[10px] italic\" data-kid=\"1-3-3-2-2-2-4-1\" data-name=\"warning impact text\">\n                                Impact: Data quality\n                            </span>\n                            <button class=\"px-4 py-1.5 border border-[var(--gold)] text-[var(--gold)] text-[10px] font-black uppercase rounded hover:bg-[var(--gold)] hover:text-[var(--navy)] transition-all\" data-kid=\"1-3-3-2-2-2-4-2\" data-name=\"warning review button\">\n                                Review\n                            </button>\n                        </div>\n                    </div>\n                    <!-- Warning Alert 2 -->\n                    <div class=\"p-4 bg-[var(--gold)]/5 border-l-[3px] border-[var(--gold)] relative group\" data-dynamic=\"true\" data-kid=\"1-3-3-2-2-3\" data-name=\"warning alert 2 card\" data-reason=\"rendered dynamically from alert feed script\">\n                        <div class=\"flex justify-between items-start mb-1.5\" data-kid=\"1-3-3-2-2-3-1\" data-name=\"warning meta\">\n                            <span class=\"text-[var(--gold)] text-[10px] font-bold uppercase tracking-[0.1em]\" data-kid=\"1-3-3-2-2-3-1-1\" data-name=\"warning label\">\n                                Execution Pending\n                            </span>\n                            <span class=\"text-[var(--text-muted)] text-[10px] mono\" data-kid=\"1-3-3-2-2-3-1-2\" data-name=\"warning time\">\n                                13:58:44\n                            </span>\n                        </div>\n                        <h4 class=\"text-white text-[13px] font-bold mb-1\" data-kid=\"1-3-3-2-2-3-2\" data-name=\"warning title\">\n                            2 orders pending manual review\n                        </h4>\n                        <p class=\"text-[var(--text-muted)] text-[11px] leading-relaxed mb-4\" data-kid=\"1-3-3-2-2-3-3\" data-name=\"warning description\">\n                            Compliance check triggered on ES basket trade execution.\n                        </p>\n                        <div class=\"flex items-center justify-between\" data-kid=\"1-3-3-2-2-3-4\" data-name=\"warning actions\">\n                            <span class=\"text-[var(--text-muted)] text-[10px] italic\" data-kid=\"1-3-3-2-2-3-4-1\" data-name=\"warning impact text\">\n                                Action: Approval required\n                            </span>\n                            <button class=\"px-4 py-1.5 border border-[var(--gold)] text-[var(--gold)] text-[10px] font-black uppercase rounded hover:bg-[var(--gold)] hover:text-[var(--navy)] transition-all\" data-kid=\"1-3-3-2-2-3-4-2\" data-name=\"warning review button\">\n                                Review\n                            </button>\n                        </div>\n                    </div>\n                </div>\n                <!-- Legend Bottom -->\n                <div class=\"px-5 py-3 border-t border-[var(--border)] flex items-center gap-6 text-[10px] font-bold uppercase tracking-[0.1em]\" data-kid=\"1-3-3-2-3\" data-name=\"alerts legend container\">\n                    <span class=\"text-[var(--text-muted)] opacity-50\" data-kid=\"1-3-3-2-3-1\" data-name=\"legend header\">\n                        Severity Legend:\n                    </span>\n                    <div class=\"flex items-center gap-2\" data-kid=\"1-3-3-2-3-2\" data-name=\"critical legend item\">\n                        <span class=\"w-2 h-2 bg-[var(--red)] rounded-full\" data-kid=\"1-3-3-2-3-2-1\" data-name=\"critical circle\">\n                        </span>\n                        critical\n                    </div>\n                    <div class=\"flex items-center gap-2\" data-kid=\"1-3-3-2-3-3\" data-name=\"warning legend item\">\n                        <span class=\"w-2 h-2 bg-[var(--gold)] rounded-full\" data-kid=\"1-3-3-2-3-3-1\" data-name=\"warning circle\">\n                        </span>\n                        warning\n                    </div>\n                    <div class=\"flex items-center gap-2\" data-kid=\"1-3-3-2-3-4\" data-name=\"info legend item\">\n                        <span class=\"w-2 h-2 bg-[var(--text-muted)] rounded-full\" data-kid=\"1-3-3-2-3-4-1\" data-name=\"info circle\">\n                        </span>\n                        info\n                    </div>\n                </div>\n            </div>\n        </div>\n        <!-- THIRD ROW: POSITIONS, EXECUTION, HEALTH -->\n        <div class=\"grid grid-cols-3 gap-6 pb-8\" data-kid=\"1-3-4\" data-name=\"positions execution and health row\">\n            <!-- Open Positions -->\n            <div class=\"bg-[var(--panel)] border border-[var(--border)] flex flex-col h-[380px]\" data-kid=\"1-3-4-1\" data-name=\"open positions portfolio card\">\n                <div class=\"px-5 py-4 border-b border-[var(--border)] flex justify-between items-center bg-[var(--navy)]/30\" data-kid=\"1-3-4-1-1\" data-name=\"portfolio header\">\n                    <h3 class=\"text-white text-sm font-bold uppercase tracking-widest\" data-kid=\"1-3-4-1-1-1\" data-name=\"portfolio title\">\n                        Open Positions Portfolio [4]\n                    </h3>\n                    <span class=\"text-[var(--green)] text-sm font-black mono\" data-dynamic=\"true\" data-kid=\"1-3-4-1-1-2\" data-name=\"total unrealized p&l\" data-reason=\"value updated by real-time position feed script\">\n          