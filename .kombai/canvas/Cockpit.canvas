 data-name=\"system metrics group\">\n                        <div class=\"flex items-center justify-between\" data-kid=\"1-3-4-3-2-3-1\" data-name=\"latency container\">\n                            <span class=\"text-[13px] text-[var(--text-muted)] font-bold opacity-60\" data-kid=\"1-3-4-3-2-3-1-1\" data-name=\"latency label\">\n                                TRADING API LATENCY\n                            </span>\n                            <div class=\"flex items-center gap-3\" data-kid=\"1-3-4-3-2-3-1-2\" data-name=\"latency graph container\">\n                                <span class=\"text-white text-[13px] font-black mono\" data-dynamic=\"true\" data-kid=\"1-3-4-3-2-3-1-2-1\" data-name=\"latency value\" data-reason=\"value updated by real-time connectivity script\">\n                                    4ms\n                                </span>\n                                <div class=\"flex gap-1 items-end h-4\" data-kid=\"1-3-4-3-2-3-1-2-2\" data-name=\"latency bars container\">\n                                    <div class=\"w-1 h-[40%] bg-[var(--green)]\" data-kid=\"1-3-4-3-2-3-1-2-2-1\" data-name=\"bar 1\">\n                                    </div>\n                                    <div class=\"w-1 h-[60%] bg-[var(--green)]\" data-kid=\"1-3-4-3-2-3-1-2-2-2\" data-name=\"bar 2\">\n                                    </div>\n                                    <div class=\"w-1 h-[90%] bg-[var(--green)]\" data-kid=\"1-3-4-3-2-3-1-2-2-3\" data-name=\"bar 3\">\n                                    </div>\n                                    <div class=\"w-1 h-[30%] bg-[var(--border)]\" data-kid=\"1-3-4-3-2-3-1-2-2-4\" data-name=\"bar 4\">\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"flex items-center justify-between\" data-kid=\"1-3-4-3-2-3-2\" data-name=\"database status group\">\n                            <span class=\"text-[13px] text-[var(--text-muted)] font-bold opacity-60\" data-kid=\"1-3-4-3-2-3-2-1\" data-name=\"database label\">\n                                MARKET DATA DATABASE\n                            </span>\n                            <span class=\"text-[var(--green)] text-[12px] font-black mono uppercase tracking-widest\" data-kid=\"1-3-4-3-2-3-2-2\" data-name=\"database status\">\n                                HEALTHY\n                            </span>\n                        </div>\n                        <div class=\"flex items-center justify-between\" data-kid=\"1-3-4-3-2-3-3\" data-name=\"logs container\">\n                            <span class=\"text-[13px] text-[var(--text-muted)] font-bold opacity-60\" data-kid=\"1-3-4-3-2-3-3-1\" data-name=\"logs label\">\n                                LOG AGGREGATOR\n                            </span>\n                            <span class=\"text-white text-[12px] font-black mono uppercase tracking-widest\" data-kid=\"1-3-4-3-2-3-3-2\" data-name=\"logs status\">\n                                ACTIVE\n                            </span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </main>\n    <!-- FOOTER COMMAND STRIP -->\n    <footer class=\"p-6 bg-[var(--navy)] border-t border-[var(--border)]\" data-kid=\"1-4\" data-name=\"footer command bar\">\n        <div class=\"flex items-center justify-between px-8 py-5 bg-[var(--panel)] border border-[var(--border)] rounded-sm\" data-kid=\"1-4-1\" data-name=\"footer control container\">\n            <div class=\"flex items-center gap-4\" data-kid=\"1-4-1-1\" data-name=\"footer status group\">\n                <div class=\"w-2.5 h-2.5 rounded-full bg-[var(--green)] shadow-[0_0_10px_var(--green)]\" data-kid=\"1-4-1-1-1\" data-name=\"status light\">\n                </div>\n                <span class=\"text-[12px] text-white font-black uppercase tracking-[0.25em]\" data-kid=\"1-4-1-1-2\" data-name=\"command hub active text\">\n                    Command Hub Active\n                </span>\n            </div>\n            <div class=\"flex items-center gap-16 text-[13px] mono\" data-kid=\"1-4-1-2\" data-name=\"shortcut key group\">\n                <div class=\"flex items-center gap-4 group cursor-pointer\" data-kid=\"1-4-1-2-1\" data-name=\"buy market key\">\n                    <span class=\"px-2.5 py-1 bg-[var(--gold)] text-[var(--navy)] font-black rounded-xs shadow-sm shadow-[var(--gold)]/20\" data-kid=\"1-4-1-2-1-1\" data-name=\"buy market shortcut key\">\n                        F1\n                    </span>\n                    <span class=\"text-[var(--text-muted)] group-hover:text-[var(--green)] font-black transition-all uppercase tracking-widest\" data-kid=\"1-4-1-2-1-2\" data-name=\"buy market text\">\n                        Buy Market\n                    </span>\n                </div>\n                <div class=\"flex items-center gap-4 group cursor-pointer\" data-kid=\"1-4-1-2-2\" data-name=\"sell market key\">\n                    <span class=\"px-2.5 py-1 bg-[var(--gold)] text-[var(--navy)] font-black rounded-xs shadow-sm shadow-[var(--gold)]/20\" data-kid=\"1-4-1-2-2-1\" data-name=\"sell market shortcut key\">\n                        F2\n                    </span>\n                    <span class=\"text-[var(--text-muted)] group-hover:text-[var(--red)] font-black transition-all uppercase tracking-widest\" data-kid=\"1-4-1-2-2-2\" data-name=\"sell market text\">\n                        Sell Market\n                    </span>\n                </div>\n                <div class=\"flex items-center gap-4 group cursor-pointer\" data-kid=\"1-4-1-2-3\" data-name=\"flatten key\">\n                    <span class=\"px-2.5 py-1 bg-[var(--gold)] text-[var(--navy)] font-black rounded-xs shadow-sm shadow-[var(--gold)]/20\" data-kid=\"1-4-1-2-3-1\" data-name=\"flatten shortcut key\">\n                        F3\n                    </span>\n                    <span class=\"text-[var(--text-muted)] group-hover:text-white font-black transition-all uppercase tracking-widest\" data-kid=\"1-4-1-2-3-2\" data-name=\"flatten text\">\n                        Flatten All\n                    </span>\n                </div>\n                <div class=\"flex items-center gap-4 group cursor-pointer\" data-kid=\"1-4-1-2-4\" data-name=\"cancel pending key\">\n                    <span class=\"px-2.5 py-1 bg-[var(--gold)] text-[var(--navy)] font-black rounded-xs shadow-sm shadow-[var(--gold)]/20\" data-kid=\"1-4-1-2-4-1\" data-name=\"cancel pending shortcut key\">\n                        ESC\n                    </span>\n                    <span class=\"text-[var(--text-muted)] group-hover:text-white font-black transition-all uppercase tracking-widest\" data-kid=\"1-4-1-2-4-2\" data-name=\"cancel pending text\">\n                        Cancel Pending\n                    </span>\n                </div>\n            </div>\n            <div class=\"flex items-center gap-5\" data-kid=\"1-4-1-3\" data-name=\"footer help group\">\n                <div class=\"flex items-center gap-3 opacity-60\" data-kid=\"1-4-1-3-1\" data-name=\"help icon and text\">\n                    <svg data-kid=\"1-4-1-3-1-1\" data-name=\"help icon\" fill=\"none\" height=\"18\" stroke=\"currentColor\" stroke-width=\"2\" viewbox=\"0 0 24 24\" width=\"18\">\n                        <circle cx=\"12\" cy=\"12\" r=\"10\">\n                        </circle>\n                        <path d=\"M12 16v-4\">\n                        </path>\n                        <path d=\"M12 8h.01\">\n                        </path>\n                    </svg>\n                    <span class=\"text-[11px] uppercase font-bold tracking-widest\" data-kid=\"1-4-1-3-1-2\" data-name=\"help text\">\n                        Press [ALT] for system settings\n                    </span>\n                </div>\n            </div>\n        </div>\n    </footer>\n</div>\n",
