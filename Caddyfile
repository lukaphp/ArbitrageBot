# Reverse proxy — accesso SOLO via rete privata (Tailscale), niente dominio pubblico.
# Ascolta in HTTP sulla rete interna: la porta viene pubblicata solo sull'IP
# Tailscale dell'host in docker-compose.yml, quindi non è raggiungibile da
# Internet — il tunnel WireGuard di Tailscale fornisce già la cifratura in
# transito, non serve un secondo strato TLS qui.
#
# Socket.IO: il reverse_proxy di Caddy gestisce gli upgrade WebSocket in automatico,
# quindi non serve configurazione extra.

:8080 {
    encode gzip
    reverse_proxy app:3000

    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
}

