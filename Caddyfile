# Reverse proxy — accesso SOLO via rete privata (Tailscale), niente dominio pubblico.
# Ascolta in HTTP su localhost soltanto (docker-compose.yml: 127.0.0.1:8080),
# quindi non raggiungibile da Internet né direttamente dalla tailnet.
# L'HTTPS reale verso la tailnet lo termina `tailscale serve` sull'host,
# fuori da Docker (certificato pubblico via Let's Encrypt, rinnovo
# automatico — vedi docs/DEPLOY.md §3), che inoltra qui in HTTP puro: due
# processi entrambi su localhost, nessun secondo strato TLS necessario tra
# i due.
#
# Socket.IO: il reverse_proxy di Caddy gestisce gli upgrade WebSocket in automatico,
# quindi non serve configurazione extra.

:8080 {
    encode gzip
    reverse_proxy app:3000

    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
}

# --- Alternativa: HTTPS pubblico con dominio ---
# Se in futuro serve raggiungere il pannello da fuori la tailnet, sostituisci
# il blocco sopra con questo (vedi docs/DEPLOY.md §3, opzione B) e imposta
# anche METRICS_TOKEN:
#
# trading.tuodominio.it {
#     encode gzip
#     reverse_proxy app:3000
#     header {
#         Strict-Transport-Security "max-age=31536000; includeSubDomains"
#         X-Content-Type-Options "nosniff"
