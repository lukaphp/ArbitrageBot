{
  "name": "arbitrage-bot-testnet",
  "version": "1.0.0",
  "description": "Bot di arbitraggio sicuro per testnet - Non utilizzare in mainnet",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "cli": "node src/index.js",
    "build": "mkdir -p dist && cp -r public dist/ && echo 'Build completato'",
    "setup": "node setup.js",
    "test": "node --test test/*.test.js",
    "test:smoke": "node test-bot.js",
    "lint": "node scripts/lint-syntax.js",
    "restart": "bash scripts/restart.sh",
    "stop": "bash scripts/restart.sh stop",
    "web": "npm run build && npm start",
    "start:infisical": "infisical run -- node src/server.js",
    "dev:infisical": "infisical run -- nodemon src/server.js",
    "secrets:check": "node scripts/check-secrets.js",
    "secrets:rotate": "node scripts/rotate-encryption-key.js",
    "mcp": "node src/mcp/server.js",
    "rebuild:native": "npm rebuild better-sqlite3 --ignore-scripts=false"
  },
  "keywords": [
    "arbitrage",
    "defi",
    "testnet",
    "ethereum",
    "bsc",
    "polygon"
  ],
  "author": "Arbitrage Bot Developer",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.102.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@playwright/test": "^1.54.2",
    "axios": "^1.5.0",
    "better-sqlite3": "^12.10.0",
    "chalk": "^5.3.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "ethers": "^6.8.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "hyperliquid": "^1.7.7",
    "node-cron": "^4.6.0",
    "socket.io": "^4.7.2",
    "technicalindicators": "^3.1.0",
    "ws": "^8.21.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.8.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
